# =============================================================================
# ODA Login Theme - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your deployment.
#
#   cp env.example .env
#
# The ODA_* variables are read by the Keycloak theme (via theme.properties
# ${env.VAR:default} substitution) and control branding + external links.
# The KC_* variables configure the Keycloak server itself (connection,
# database, admin bootstrap). NEVER commit the real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Theme branding (read by the login theme)
# -----------------------------------------------------------------------------

# Brand name shown in the page header and footer copyright.
ODA_BRAND_NAME=ODA

# Optional short tagline shown under the logo (empty = hidden).
ODA_BRAND_TAGLINE=

# Optional absolute URL to a custom logo image (empty = bundled logo.svg).
# Example: https://cdn.example.com/logo.png
ODA_LOGO_URL=

# Support email shown in the footer (empty = link hidden).
ODA_SUPPORT_EMAIL=

# Privacy policy URL shown in the footer (empty = link hidden).
ODA_PRIVACY_URL=

# Terms of service URL shown in the footer (empty = link hidden).
ODA_TERMS_URL=

# Home page URL shown in the footer (empty = link hidden).
ODA_HOME_URL=

# Brand primary color (CSS color value, any modern format).
ODA_PRIMARY_COLOR=oklch(0.5635 0.2408 260.8178)

# Text color used on top of the primary color (buttons).
ODA_PRIMARY_FOREGROUND=#ffffff

# Brand accent color used for background decoration.
ODA_ACCENT_COLOR=oklch(0.6489 0.2370 26.9728)

# -----------------------------------------------------------------------------
# Keycloak server (connection / deployment)
# -----------------------------------------------------------------------------

# Public hostname clients will use to reach Keycloak.
KC_HOSTNAME=localhost

# Proxy headers when running behind a reverse proxy (none|forwarded|xforwarded).
KC_PROXY_HEADERS=forwarded

# HTTP/HTTPS ports exposed by the container.
KC_HTTP_PORT=8080
KC_HTTPS_PORT=8443

# Database connection (PostgreSQL recommended for production).
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change_me

# Initial admin user (Keycloak 26+ bootstrap admin).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me

# -----------------------------------------------------------------------------
# PostgreSQL (only used by the bundled docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change_me